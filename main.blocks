lue></block></statement><value name="IF2"><shadow type="logic_boolean" id="}x)zhSqn@1O=bl[b%9h:"><field name="BOOL">TRUE</field></shadow><block type="gameask" id="tiXHXmNA_y@bs6h=yyd)"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="rYRZsV5SYHLDjs4C?kE+"><field name="TEXT">Mochila +1: $20</field></shadow></value><value name="subtitle"><shadow type="text" id="^my;gnFg+J.wJ27lN`Y1"><field name="TEXT">A: comprar / B: volver</field></shadow></value></block></value><statement name="DO2"><block type="variables_change" id="@!KKnM0WR3J,(tEtNrv$"><field name="VAR" id="3w/?`yfeO)9f_T35p^1]">dinero</field><value name="VALUE"><shadow type="math_number" id="@LOi%~(`1#eeU(z*Aqb("><field name="NUM">-20</field></shadow></value><next><block type="variables_change" id="0trEquY)h$.J#if$~VDi"><field name="VAR" id="8c3[6|!tEI!+P]I--8?$">capacidadPiezas</field><value name="VALUE"><shadow type="math_number" id="~nr][vBE?)K2+7~Ep18P"><field name="NUM">1</field></shadow></value></block></next></block></statement><next><block type="function_call" id="NNK_Ic1F-qR.E~#pk9B~"><mutation name="continuarExplorando" functionid="0Wx[nc:7f`Y08huQJB(v"></mutation></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="1Ih6{M9FhYU*d8erU$7@" x="0" y="3333"><mutation name="revelacionFinal" functionid="=Kf1Ax~77.iAn5=ND$v;"></mutation><field name="function_name">revelacionFinal</field><statement name="STACK"><block type="game_show_long_text" id="dMiM_iKXrp8;nnKq_7S{"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="IV,Ju+qQM7gKro=z:K*;"><field name="TEXT">Nodo recibe una foto desde 2126: la maquina vieja tiene una placa oculta bajo el polvo.</field></shadow></value><next><block type="game_show_long_text" id="}F0$cC*jL65xA;o]jd|v"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="x*V-K@T=J:X}P|NOQ8Va"><field name="TEXT">Dice: construida por Nico, Cami, Ale y Cris. Ustedes la construiran cuando sean grandes, despues de aprender a reparar su ciudad.</field></shadow></value><next><block type="game_show_long_text" id="D(bRfT@%b98mb=b~C,S`"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="h|Iac_4rL+],XhW/{:,K"><field name="TEXT">Somos sus nietos y nietas. Encontramos la maquina y sus planos. El simbolo de las reparaciones se convirtio en la firma de su equipo.</field></shadow></value><next><block type="game_show_long_text" id="=^a/)?ERr$yYdOR9JM])"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="Bo2iDW=RdcUB/z0D)2R+"><field name="TEXT">La maquina se quedo en 2126. Solo los mensajes viajan por Nodo. Cada vez que ustedes reparaban algo, veiamos mejorar nuestra ciudad.</field></shadow></value><next><block type="game_show_long_text" id="4zFzSDbA9{2x#s|Y9eX^"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="?/A*Lz?4_0g1pt-GtIR`"><field name="TEXT">Gracias por escucharnos. Cuidar el agua, el aire y la naturaleza necesita muchas acciones. El futuro se construye desde hoy.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="]ZciCLO4N=Nw7$b{NR,Q" x="878" y="3333"><mutation name="limpiarEscenario" functionid="U.{H@#Z$`v@W8?R8#K;e"></mutation><field name="function_name">limpiarEscenario</field><statement name="STACK"><block type="sprites_destroy_all_sprites_of_kind" id="zM#f!pTbXh%f3^GUG)I;"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="kind"><shadow type="spritekind" id="la#vA~}MZEi~UEbDA$8O"><field name="MEMBER">Pieza</field></shadow></value><next><block type="sprites_destroy_all_sprites_of_kind" id="a`m).$w]nwuDYf$rNE^v"><mutation xmlns="http://www.w3.org/