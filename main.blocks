pe="logic_boolean" id="hM0E1SIo%MDg?~x*lp96"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="nPdNw*{?aKA:kv|[TuHW"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="9qL3Q=BV!SJ7nBNh)37y"><field name="NUM">0</field></shadow><block type="variables_get" id="1yeNNOK]#j|Kdx3ul:e0"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="j|sasQ8XutaX(oSltT^["><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="function_call" id="R0d:TvQI!91pWaWnK4e}"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="M$@Nxu6e-+X%K{:p672*"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="f.9AUZ8kOwUPwmtN-DaK"><field name="TEXT"></field></shadow><block type="text_join" id="J9D8}5t_:)SoCQPY4u_R"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="L_=.0BB;H?9oq7dV~BUq"><field name="TEXT">2126: La basura se acumula sin control. El reciclador está roto. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id="z%h,uJ;@_0wA|J8Nf;X$"><field name="TEXT"></field></shadow><block type="variables_get" id="HCmH~~e9~5Z0a4r+r3s8"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="A!,]Rr3YA4gl/}l}@36f"><field name="TEXT"> piezas y repáralo. ¡El planeta te necesita!</field></shadow></value></block></value></block></next></block></statement><value name="IF1"><shadow type="logic_boolean" id="4+?VO0+w{D[ZFI#@shBi"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="y:!)%h7`=01GMK[-yFm`"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="cT8^++tuw[9jODE`Ee.c"><field name="NUM">0</field></shadow><block type="variables_get" id="9oRp04TNQC6@#5^_zh{N"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="i--{8j_g$qM*LtXT0Q8,"><field name="NUM">2</field></shadow></value></block></value><statement name="DO1"><block type="function_call" id="eAy;Uh_qMm+DU:#KEB8L"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="I3cQkX-`)8D()*?di}rR"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="631lenuzsRpRO^fB;2jB"><field name="TEXT"></field></shadow><block type="text_join" id="{(,(!`FTB*RHKD2H%PPB"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="VRK@HK]Me`?!)L/-NR0B"><field name="TEXT">2126: El agua escasea y el río bajó lleno de basura. La planta de tratamiento está destruida. Necesitas </field></shadow></value><value name="ADD1"><shadow type="text" id="z/CU%rz^t85QLj-{@{@U"><field name="TEXT"></field></shadow><block type="variables_get" id="__aj^VK)g;ue+8`|N0nR"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="b#Jx(uS%%_`nHg62KQlg"><field name="TEXT"> piezas: búscalas en la ciudad, o métete al agua, engancha la basura y llévala a la planta.</field></shadow></value></block></value></block></next></block></statement><value name="IF2"><shadow type="logic_boolean" id="a4c}DWTCUwB1%Q3f9?$-"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="1Rx3f#a3paV0PM%3?OPO"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="!)2QHG@5Jbg3-8fRPv=0"><field name="NUM">0</field></shadow><block type="variables_get" id="Bv0fYGp6{3IjND0]~DHB"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="dDtjCrA@B=[e-jr:[,}a"><field name="NUM">3</field></shadow></value></block></value><statement name="DO2"><block type="function_call" id="G^NFDKZ|b[otVtmCY=Ij"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="1@9/;:]vD@iTxL[ff$mJ"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="j1vgzIgteL!b;sy|J^z%"><field name="TEXT"></field></shadow><block type="text_join" id="(;Nj^}%VW7=V%oz}AU^y"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="%|!Fm[j-pG+1T@BuIIHm"><field name="TEXT">2126: El aire es tóxico. Las máquinas de filtración no funcionan hace años. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id=")k9;9#7vBn{I|g@o98w*"><field name="TEXT"></field></shadow><block type="variables_get" id="GK)u{;I*K45t,E@X?dn-"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="BkINM{Q!f;bM%rSmoapU"><field name="TEXT"> piezas y actívalas. Necesitamos aire limpio.</field></shadow></value></block></value></block></next></block></statement><statement name="ELSE"><block type="function_call" id="#r[SBT#{2T*yO%a*oe/K"><mutation name="calcularCosto" functionid="_#8t?~,x~!bn.U^_xHog"></mutation><next><block type="game_show_long_text" id="}XKd!0K[g`XU;;ZZb;Wo"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="CgDHvZtC}Q8bo!35=+:T"><field name="TEXT"></field></shadow><block type="text_join" id="HH:Z:eu,Ig~-#YA7m_hR" inline="false"><mutation items="5"></mutation><value name="ADD0"><shadow type="text" id="bg53Ud9^e#G9=qc;=hJ*"><field name="TEXT">2126: El parque necesita vida. Camina hasta </field></shadow></value><value name="ADD1"><shadow type="text" id="].pFach))^jJ4zyF{x3V"><field name="TEXT"></field></shadow><block type="variables_get" id="R=8g%Wi;Y7IRDB:ygI1S"><field name="VAR" id="f2N+b!I{CsYP){S#_^Gu">arbolesParaGanar</field></block></value><value name="ADD2"><shadow type="text" id="?97RMGPJ.ft!8%?U-AAu"><field name="TEXT"> arboles secos para regarlos. Luego busca </field></shadow></value><value name="ADD3"><shadow type="text" id="Rk;Eu]}S)G^]uYeu4;o]"><field name="TEXT"></field></shadow><block type="variables_get" id="~D?y@Q%#|,vqkjHY3`+P"><field name="VAR" id="9knKrek9@hCE~0[8Jop5">costoReparacion</field></block></value><value name="ADD4"><shadow type="text" id="lo;3X6CaE!WAw0m|~Yd["><field name="TEXT"> piezas y repara el riego. Cuida los brotes verdes: si los pisas, pulsa A sobre ellos para revivirlos.</field></shadow></value></block></value></block></next></block></statement><next><block type="function_call" id="f/#tf4WK]zXCXzB.8rqg"><mutation name="continuarExplorando" functionid="0Wx[nc:7f`Y08huQJB(v"></mutation></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="_5Ar9?VveOp?Z6ARIJq]" x="3307" y="4643"><mutation name="anunciarCiudad" functionid="UVFkYN[zj]@Js+JVa|xu"></mutation><field name="function_name">anunciarCiudad</field><statement name="STACK"><block type="controls_if" id="vF_M$[vj;ngNa`yJ?84/"><mutation elseif="2" else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="nJL{0Q,i_qG.N+=*i*TS"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="rg+YdHhw}xQ#o4Wa%IzQ"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="s_{Y=%a[j#p:pQtZF$ot"><field name="NUM">0</field></shadow><block type="variables_get" id="1w}nXUsWmK`]Zykc;sse"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id=",Qsm(lz}lO5wK1%mEkKI"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="gameSplash" id="Rp}b{Hyl-iAo`GAmmJ2h"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="hQwN6.UEvb^*-N66LQo@"><field name="TEXT">CIUDAD DEL RECICLAJE</field></shadow></value><value name="subtitle"><shadow type="text" id="mTMv|Wkb1QK]F#.@xtW]"><field name="TEXT">Mensaje 1 de 4</field></shadow></value></block></statement><value na