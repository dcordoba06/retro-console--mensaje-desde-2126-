e><next><block type="spritesetkind" id="D^@_ZJ}=#H!A%]k,7Sme"><value name="sprite"><block type="variables_get" id="CbY+0kzbNCL0=,QmD3:6"><field name="VAR" id="Pk*{SC+i!p9;}u/W|9%z">broteElegido</field></block></value><value name="kind"><shadow type="spritekind" id="0ZqcB9T2n^2hXJ8mF_)`"><field name="MEMBER">Brote</field></shadow></value><next><block type="variables_set" id="kOw{E{Ln(Fk/M]o|AnA;"><field name="VAR" id="2F{l:(;csstdX!#4/Zi{">protegidoHasta</field><value name="VALUE"><shadow type="math_number" id="|y`Z^FvAP9I0:%_MYBrp"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="vVx-?T!L!!4E}0qIW]y["><field name="OP">ADD</field><value name="A"><shadow type="math_number" id="QfSSIKIn]MZRq]eOrj1|"><field name="NUM">0</field></shadow><block type="arcade_game_runtime" id="G.Ts3%/[xsUN*dX2pO6}"></block></value><value name="B"><shadow type="math_number" id="Je9Ipathz{swbMm:zkRc"><field name="NUM">2500</field></shadow></value></block></value><next><block type="hudChangeScoreBy" id="6q^[_$T,8B`F!c[nBTzk"><value name="value"><shadow type="math_number" id="co?9FCrKNNs,QH$~,m9u"><field name="NUM">10</field></shadow></value><next><block type="spritesaytext" id="5(8.wr6?hUr_%e87*d?="><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="this"><block type="variables_get" id="4Z+4CXB09R7JQ(Sia=Kj"><field name="VAR" id="6O,tWiXxRkaE3*UBfMAl">jugador</field></block></value><value name="text"><shadow type="text" id="v.Ufc*K;W|7i|E*el+YX"><field name="TEXT">Revivio! Cuidado donde pisas</field></shadow></value><value name="timeOnScreen"><shadow type="timePicker" id="#:Z-=.,@%GgCV_begfL:"><field name="ms">1000</field></shadow></value><value name="animated"><shadow type="logic_boolean" id="rSw3mk0e}V}?*~s#~|~}"><field name="BOOL">FALSE</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="s@gOWb8_Hau+?O1r$U0D" x="8656" y="3333"><mutation name="presentarHistoria" functionid="cq%Pg;aAHEARZ)qvXnIK"></mutation><field name="function_name">presentarHistoria</field><statement name="STACK"><block type="gamesetbackgroundimage" id="qyoL!5d:QU18n}Q$lP^7"><value name="img"><shadow type="background_image_picker" id=";vNHeuu:GM=F{N)?x`:-"><field name="img">assets.image`portadaHistoria0`</field><data>{"commentRefs":[],"fieldData":{"img":"myImages.portadaHistoria"}}</data></shadow></value><next><block type="gameSplash" id="~1oZt|BSnE_vd0.w;wR^"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="~j5r:tiCNS/NqLe`D_/~"><field name="TEXT">Mensaje desde 2126</field></shadow></value><value name="subtitle"><shadow type="text" id="Q)BbIRroHf{6xo}_OUM:"><field name="TEXT">Ayuda hoy al futuro</field></shadow></value><next><block type="game_show_long_text" id="+)hww{;?B-?C{Eb]fhTa"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="9K.Z/r!%$y8;MH;y:HXT"><field name="TEXT">2026. Nico, Cami, Ale y Cris reciben un mensaje de una cuenta desconocida en Nodo, su aplicacion de chat. Dice venir de 2126...</field></shadow></value><next><block type="game_show_long_text" id="*g-mqO*:f~Otm`a)tnt%"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="r+ENppy9K=:A@Gt)_YaK"><field name="TEXT">Somos sus nietos y nietas. Encontramos una maquina vieja que envia mensajes al pasado. La conectamos a Nodo. Aqui falta agua limpia, hay basura y casi no quedan zonas verdes.</field></shadow></value><next><block type="game_show_long_text" id="-o|cf0wiQ+DU-C!)OX;Z"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="MC?;(%k/-N/ukt7B}%kQ"><field name="TEXT">Sus acciones de hoy cambian nuestro futuro. Elige tu personaje. Flechas: caminar. A: usar equipos. B: leer Nodo. La terminal de la base recibe los mensajes. No hay combates.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="$xg}4P@=M+DI@z,rWtP{" x="9534" y="3333"><mutation name="finalDelJuego" functionid="t{,?l1*9}{#05Ygj2d_e"></mutation><field name="function_name">finalDelJuego</field><statement name="STACK"><block type="variables_set" id="]F`4LLD@-(yzLl}p|zS^"><field name="VAR" id=";(Z2Kd8aY=pqpEvdUhM+">estado</field><value name="VALUE"><shadow type="math_number" id="PaViHgTz}rkrLWa*-7Zx"><field name="NUM">0</field></shadow><block type="text" id="qoUqOWv]Pf2m!nCN:_^i"><field name="TEXT">mensaje</field></block></value><next><block type="game_control_sprite" id="32sS4qjQxHa;fOQ#EkHM"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="eQ(8OyB@VJym[-y6YGto"><field name="VAR" id="6O,tWiXxRkaE3*UBfMAl">jugador</field></block></value><value name="vx"><shadow type="spriteSpeedPicker" id="Ep:B.;yC|n2qqmAV,(]w"><field name="speed">0</field></shadow></value><value name="vy"><shadow type="spriteSpeedPicker" id="|;uFHr?cts{7$9?-tP+s"><field name="speed">0</field></shadow></value><next><block type="game_show_long_text" id="]}%v@ARRHQw9X}{Hf5H5"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="isaS:1HOqJ6=C5tv.Qab"><field name="TEXT">Nodo: enviando a 2126 el reporte del parque...</field></shadow></value><next><block type="game_show_long_text" id="sZy+r8kcQy/k9~RR-W@("><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="]xG5O2TV@Q5LyY5^VR%N"><field name="TEXT">2126: El parque esta lleno de gente. Hay sombra, hay pajaros, y el aire huele a tierra mojada. Crecimos jugando aqui.</field></shadow></value><next><block type="function_call" id="]VZQ4znHOS!5i2?qro~]"><mutation name="revelacionFinal" functionid="=Kf1Ax~77.iAn5=ND$v;"></mutation><next><block type="controls_if" id="rjBQ}jlZq[VW:auFjmu."><mutation elseif=