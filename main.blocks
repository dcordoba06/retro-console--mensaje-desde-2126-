bctH=/+T4">jugador</field></block></value><value name="vx"><shadow type="spriteSpeedPicker" id="kKIHZKC#jM35rh;?^Bl["><field name="speed">0</field></shadow></value><value name="vy"><shadow type="spriteSpeedPicker" id=".GlBjOKCRjc;TI(TwaA4"><field name="speed">0</field></shadow></value><next><block type="controls_if" id="V[u^kzc6pq+,3N]Y?Vf["><mutation elseif="2"></mutation><value name="IF0"><shadow type="logic_boolean" id=":v`q{=kJ|YD?ktALTnER"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="VN;4R3i]hi!WPT#[37IP"><field name="OP">GTE</field><value name="A"><shadow type="math_number" id="3(~cY{X8:HpEOsfnS/3q"><field name="NUM">0</field></shadow><block type="variables_get" id="ZDbWdFjTc|h_eGGij*/,"><field name="VAR" id="|n`(4xeo%8ZBWiRPt=f7">capacidadPiezas</field></block></value><value name="B"><shadow type="math_number" id="1KjF3TKv0P87)195,-:W"><field name="NUM">5</field></shadow></value></block></value><statement name="DO0"><block type="game_show_long_text" id="yS*g.Y{=LR[^F|C=)Pq)"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="nVj{FWxBY1.y}w):fxF@"><field name="TEXT">Tu mochila ya puede cargar 5 piezas.</field></shadow></value></block></statement><value name="IF1"><shadow type="logic_boolean" id="CMzEFz2=y)cTtJ[kIi_x"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="VckMg--cGsK=jT)K7o,1"><field name="OP">LT</field><value name="A"><shadow type="math_number" id="ddH%1@5g?~Om_v2f*z76"><field name="NUM">0</field></shadow><block type="variables_get" id="fAL{pbRe4$;rU`*^d6ST"><field name="VAR" id="Qj(gYF18}jA[,|e+ZQZ9">dinero</field></block></value><value name="B"><shadow type="math_number" id="Dszy+j6M:nz_x!vM^Iwo"><field name="NUM">20</field></shadow></value></block></value><statement name="DO1"><block type="game_show_long_text" id="N_hG~x6Mx!^B9}{SmamX"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="lJkgZcs!4Wt(Gz(~hqD6"><field name="TEXT">Mochila +1: cuesta 20 monedas. Encuentra monedas amarillas en la ciudad.</field></shadow></value></block></statement><value name="IF2"><shadow type="logic_boolean" id="*=s7U9Y(c*2^[f(jOaS-"><field name="BOOL">TRUE</field></shadow><block type="gameask" id="r]?wV|{2jL!oo-PQ(ZwI"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="s9Z#f-%EiahTpxnb#zxJ"><field name="TEXT">Mochila +1: $20</field></shadow></value><value name="subtitle"><shadow type="text" id=".G6*4bb_9`]tBxqc~A!/"><field name="TEXT">A: comprar / B: volver</field></shadow></value></block></value><statement name="DO2"><block type="variables_change" id="}CtHaC7R6!D4JV):8RF@"><field name="VAR" id="Qj(gYF18}jA[,|e+ZQZ9">dinero</field><value name="VALUE"><shadow type="math_number" id="s~8D//=Zg}6K2bzO8Am`"><field name="NUM">-20</field></shadow></value><next><block type="variables_change" id="b_7|K*qUBy~LBqQ`dsRV"><field name="VAR" id="|n`(4xeo%8ZBWiRPt=f7">capacidadPiezas</field><value name="VALUE"><shadow type="math_number" id="~Ig0?z@J-8s@Ji#iv?HX"><field name="NUM">1</field></shadow></value></block></next></block></statement><next><block type="function_call" id="@e{5Dv%1JJmoahL08r(B"><mutation name="continuarExplorando" functionid="xVy%$H(|^)h@emTZ+FR@"></mutation></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="s(2BN^8tiaq/!R;ES7PN" x="9565" y="1972"><mutation name="revelacionFinal" functionid="ik#!S{Zz2P#syHc;7X;w"></mutation><field name="function_name">revelacionFinal</field><statement name="STACK"><block type="game_show_long_text" id="!f(qT0-{,OhW~iYz9#}A"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="RrR2[;.c3sit6gr*pW]!"><field name="TEXT">Nodo recibe una foto desde 2126: la maquina vieja tiene una placa oculta bajo el polvo.</field></shadow></value><next><block type="game_show_long_text" id="%fDXNgycP,XPdBoF=Wwn"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="-Gsbyzu.dfA#]2J;4WH]"><field name="TEXT">Dice: construida por Nico, Cami, Ale y Cris. Ustedes la construiran cuando sean grandes, despues de aprender a reparar su ciudad.</field></shadow></value><next><block type="game_show_long_text" id="TG:9/VN0:H=v0J]7R@}5"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="0O#t=M)tMIstjDpn8P*3"><field name="TEXT">Somos sus nietos y nietas. Encontramos la maquina y sus planos. El simbolo de las reparaciones se convirtio en la firma de su equipo.</field></shadow></value><next><block type="game_show_long_text" id="wWh5vqwfeQYWw!r9w+*?"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="|[Y+9.Kkh6[9$riBu%CG"><field name="TEXT">La maquina se quedo en 2126. Solo los mensajes viajan por Nodo. Cada vez que ustedes reparaban algo, veiamos mejorar nuestra ciudad.</field></shadow></value><next><block type="game_show_long_text" id="(elXe/IbjMU|3qVCU-7X"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="/X+1c,eM~.R:x-g!a/5~"><field name="TEXT">Gracias por escucharnos. Cuidar el agua, el aire y la naturaleza necesita muchas acciones. El futuro se construye desde hoy.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="-Un:02{iqqd,]1[$7];s" x="20" y="2876"><mutation name="limpiarEscenario" functionid="a2OaWz-U|sP{4]T*Mua`"></mutation><field name="function_name">limpiarEscenario</field><statement name="STACK"><block type="sprites_destroy_all_sprites_of_kind" id="w#)W|-(*GYFdiI-~8Rz%"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="kind"><shadow type="spritekind" id="kK_6AieA=w`i2n+LbkN1"><field name="MEMBER">Pieza</field></shadow></value><next><block typ