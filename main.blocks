ue name="ADD1"><shadow type="text" id="7z,S.B)r=RO,J_Ert6,*"><field name="TEXT"></field></shadow><block type="variables_get" id="CD{C}HK#eLXzTK@81lZN"><field name="VAR" id=".hSJRi0$qn!,.{PnZN)?">rango</field></block></value></block></value><value name="subtitle"><shadow type="text" id="FDxKX7ClG#Q[f2-gTVrx"><field name="TEXT">Gracias por salvarnos</field></shadow></value><next><block type="gameOver" id="?~2kCvd%:AFs_/rJ;78{"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="effect">effects.confetti</field><value name="win"><shadow type="toggleWinLose" id="q0Wbq2|u?x=6PnGMGq-A"><field name="win">true</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="3[Z3C^g=9G(=Xrr:+}93" x="0" y="4643"><mutation name="respuestaDel2126" functionid="MMqD).f0xCk[M23?,b+s"></mutation><field name="function_name">respuestaDel2126</field><statement name="STACK"><block type="game_show_long_text" id="aSPg.7bnF0hwi#r~$MJ!"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="2ZCvZin`Rt,[X~,f`ST)"><field name="TEXT">Nodo: enviando a 2126 el reporte de la reparacion...</field></shadow></value><next><block type="controls_if" id="5FD8XWc7/,wAXj`Yb6rs"><mutation elseif="1" else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id=";V@GxS:2}p`(C+!{VTY/"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="BtfmlU_CoAZjPxVw}/fc"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="EWycV3@7%AK7+N.|SP4m"><field name="NUM">0</field></shadow><block type="variables_get" id="ww/L)0Ux-GK{X/E{.s/("><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="u+*xltW6E:.:Szg{A{@5"><field name="NUM">1</field></shadow></value></block></value><statement name="DO0"><block type="game_show_long_text" id="+0R;_HC94kJqG!0JgdI4"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="o;|S6)8`WiwFV1v@A!YA"><field name="TEXT">2126: Lo estamos viendo cambiar delante nuestro. El vertedero que había junto al colegio hoy es una plaza con árboles. Reciclar desde su tiempo hizo que nunca llegara a crecer.</field></shadow></value><next><block type="game_show_long_text" id="g6xM|m?,{{)_PKXSn^hk"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="yFSHh#+c*W*,dV|bhX:)"><field name="TEXT">Primera pista: detrás del recolector apareció un símbolo. Los nietos dicen que tambien esta en su maquina. ¿Quien lo puso ahi?</field></shadow></value></block></next></block></statement><value name="IF1"><shadow type="logic_boolean" id="8YcR+06t;qN?tfJQVnPe"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="P{aEP|G20?z.d$jXl;}V"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="w~9Stgoc{Dva{WV/DP#8"><field name="NUM">0</field></shadow><block type="variables_get" id="D8@eCq%nj!r[kE*-3b=|"><field name="VAR" id="^Hrt?)YkJ+K0/{2uA!|Y">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="RKrC.tE=j3@TrvCBMx)6"><field name="NUM">2</field></shadow></value></block></value><statement name="DO1"><block type="game_show_long_text" id="6}b^=pYQ`BdQdv=(lb1@"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="ohGSS$4=-VjY-B6R#M]{"><field name="TEXT">2126: El río volvió. La planta y el cuidado del rio ayudaron a recuperar el agua. Hoy bebemos de ahí y hay peces otra vez.</field></shadow></value><next><block type="game_show_long_text" id="ii9Ma|F~x,dH7VhL$~wi"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="ZgCPrf;0IZJvP_?-ePsz"><field name="TEXT">Segunda pista: el mismo símbolo está grabado en la planta. Alguien lo dejó ahí antes de que ustedes llegaran.</field></shadow></value></block></next></block></statement><statement name="ELSE"><block type="game_show_long_text" id="X[ggE]1gnCuGIXWr]c*B"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id=")Tw5NLlKxtUK73y-)=6h"><field name="TEXT">2126: Hoy vimos el cielo azul por primera vez. Sus reparaciones iniciaron cien anos de cuidado, mantenimiento y aire mas limpio.</field></shadow></value><next><block type="game_show_long_text" id="P-jX=#e877EUbY_SOnYz"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="i00MdKuRdv8q:P=iQ11a"><field name="TEXT">Tercera pista: otra vez el símbolo, y esta vez con una fecha grabada al lado. Es la fecha de hoy. La de ustedes.</field></shadow></value></block></next></block></statement></block></next></block></statement></block><block type="function_definition" id="IV*AtM@.kb8FQXKsyv~8" x="894" y="4643"><mutation name="prepararPersonaje" functionid=":1{mV??t+/%n32*kS}3Z"></mutation><field name="function_name">prepararPersonaje</field><statement name="STACK"><block type="variables_set" id="p5:Z8KrKl|Zm3SiARxg5"><field name="VAR" id="8c3[6|!tEI!+P]I--8?$">capacidadPiezas</field><value name="VALUE"><shadow type="math_number" id="M%Bm4k3Pah^Vke*LOOH6"><field name="NUM">3</field></shadow></value><next><block type="variables_set" id="[k~oY60b#$CyHM)rX%Io"><field name="VAR" id="$T^f;odV|2OM!3dkX)lF">velocidad</field><value name="VALUE"><shadow type="math_number" id="-}I(lOk%)zw9`@x.%ecD"><field name="NUM">90</field></shadow></value><next><block type="variables_set" id="*%P[U+YgF-v2eQPHg:b/"><field name="VAR" id="fiNfVIfU4mcvfCaLVV|V">descuentoPiezas</field><value name="VALUE"><shadow type="math_number" id="(s:23tkiiqE3GmFhHl)O"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="Y@A6+ROvt@w(:,gw4YX|"><field name="VAR" id="ZduB2!`NCgY*ig4|}Y18">puntosReparacion</field><value name="VALUE"><shadow type="math_number" id="GGglJCGc]5R)Kqm;a9KX"><fie