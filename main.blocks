i_R"><value name="value"><shadow type="math_number" id="T27@c**p~s)-lpq{lSg0"><field name="NUM">10</field></shadow></value><next><block type="spritesaytext" id="_0xOWv,:uuaRzypM4D!9"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="this"><block type="variables_get" id="(VEpa~16E(rxPQp.=19~"><field name="VAR" id="!i!j$hv?[WQbctH=/+T4">jugador</field></block></value><value name="text"><shadow type="text" id="6[^SD,iM:U||w0JH.2@^"><field name="TEXT">Revivio! Cuidado donde pisas</field></shadow></value><value name="timeOnScreen"><shadow type="timePicker" id="w*!puQ^,OX.X9|20|Af5"><field name="ms">1000</field></shadow></value><value name="animated"><shadow type="logic_boolean" id="CT4DCUz/fHR@5#1BQ6iB"><field name="BOOL">FALSE</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="M7:r4/gr}l}t6WYW~+oF" x="7025" y="2876"><mutation name="presentarHistoria" functionid="*]:w/`u5gW#|naex8Z[?"></mutation><field name="function_name">presentarHistoria</field><statement name="STACK"><block type="gamesetbackgroundimage" id="tgP9dVpnG+H,5T$l)!oN"><value name="img"><shadow type="background_image_picker" id="Kc|Yd#^D]t8~5BnzY8h~"><field name="img">assets.image`portadaHistoria0`</field><data>{"commentRefs":[],"fieldData":{"img":"myImages.portadaHistoria"}}</data></shadow></value><next><block type="gameSplash" id="mD^2mX=.hUPJWJE9c61s"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id=".Y%Ilo$RSs)AH%@FLs,V"><field name="TEXT">Mensaje desde 2126</field></shadow></value><value name="subtitle"><shadow type="text" id="5U1XeBx:.EqS~z2et/Ec"><field name="TEXT">Ayuda hoy al futuro</field></shadow></value><next><block type="game_show_long_text" id="ysDia97J@-v#0w~_is-N"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="|F!%)R2gr!Wp^(TASR2X"><field name="TEXT">2026. Nico, Cami, Ale y Cris reciben un mensaje de una cuenta desconocida en Nodo, su aplicacion de chat. Dice venir de 2126...</field></shadow></value><next><block type="game_show_long_text" id="y#%i*qAP)u#8hE1~$w.H"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="(e2yZu2apOBIOwXR9A26"><field name="TEXT">Somos sus nietos y nietas. Encontramos una maquina vieja que envia mensajes al pasado. La conectamos a Nodo. Aqui falta agua limpia, hay basura y casi no quedan zonas verdes.</field></shadow></value><next><block type="game_show_long_text" id="I+LZRf86[6,`cUYr4ZtR"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="5nx68O=db_k,O{!zxT5]"><field name="TEXT">Sus acciones de hoy cambian nuestro futuro. Elige tu personaje. Flechas: caminar. A: usar equipos. B: leer Nodo. La terminal de la base recibe los mensajes. No hay combates.</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="b5eTPcgA*2i2y)v27H9." x="7902" y="2876"><mutation name="finalDelJuego" functionid="pC+v,uQ=;)]JdsPfo?I."></mutation><field name="function_name">finalDelJuego</field><statement name="STACK"><block type="variables_set" id="ODbVKwsBVIDWt5N2SuWd"><field name="VAR" id="%cn!i,s:_7SXXI~_-s#4">estado</field><value name="VALUE"><shadow type="math_number" id="$FyAM.~atV?V-hgx0]jr"><field name="NUM">0</field></shadow><block type="text" id="9LuJ2XQd^91x^@nQ[YJJ"><field name="TEXT">mensaje</field></block></value><next><block type="game_control_sprite" id="xv(Q{$IY[$-)@N4-3Xy#"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="t:@TQkwg6{YLbP5/Jb?2"><field name="VAR" id="!i!j$hv?[WQbctH=/+T4">jugador</field></block></value><value name="vx"><shadow type="spriteSpeedPicker" id="Gi1pHrO0I]:vxA!{aro)"><field name="