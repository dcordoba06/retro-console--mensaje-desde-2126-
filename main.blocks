S6V^36"><mutation name="calcularCosto" functionid="os@{nSPpzel4*Xn(JoR:"></mutation><next><block type="game_show_long_text" id="E:9-Hp`V1KzZ@{H*+Kf%"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="{:^,8M+#`kF}!q:#HE`W"><field name="TEXT"></field></shadow><block type="text_join" id="b+){VRQNqYmbXc,)R8G`"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="27p:1alyu~LO,J0G_]6s"><field name="TEXT">2126: La basura se acumula sin control. El reciclador está roto. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id="-E_%zxjvzsI%xX%X#9zZ"><field name="TEXT"></field></shadow><block type="variables_get" id="_06(*cTJjNwCHO=A@.oZ"><field name="VAR" id="~!d.=1:~98t9;^ftkQWc">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="qtW!%L[`:BO42/im3zqW"><field name="TEXT"> piezas y repáralo. ¡El planeta te necesita!</field></shadow></value></block></value></block></next></block></statement><value name="IF1"><shadow type="logic_boolean" id="u*x[O_-_T.zhqDM?~-${"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="M;H(Sc]l}L_R6ez^foyF"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="?T7.-6-Eu^$GZNX0C{8W"><field name="NUM">0</field></shadow><block type="variables_get" id="7eScdk_PWGuQgsQ4-|3{"><field name="VAR" id="IKW{M#fAJX.[|WI`W3oD">nivelActual</field></block></value><value name="B"><shadow type="math_number" id=":m{yrM+BQ9%y01TmCCx_"><field name="NUM">2</field></shadow></value></block></value><statement name="DO1"><block type="function_call" id="NQ;~FAz.E-H9%2cl.+?V"><mutation name="calcularCosto" functionid="os@{nSPpzel4*Xn(JoR:"></mutation><next><block type="game_show_long_text" id="o=ZXs(LuqUWe0dp}Nm(#"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="c6*K,{[r=ugQD_N1h[Q}"><field name="TEXT"></field></shadow><block type="text_join" id="_$hS{!/DMskXf.td(aGY"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="5W0;w@)s(1gM|T}^jTv;"><field name="TEXT">2126: El agua escasea y el río bajó lleno de basura. La planta de tratamiento está destruida. Necesitas </field></shadow></value><value name="ADD1"><shadow type="text" id="KE6|oP:0MT?8UA%+n.h0"><field name="TEXT"></field></shadow><block type="variables_get" id="9-4YFE1{VTkFFLZ4)VK-"><field name="VAR" id="~!d.=1:~98t9;^ftkQWc">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="qnrYX|c{2_+=^#LPP~@k"><field name="TEXT"> piezas: búscalas en la ciudad, o métete al agua, engancha la basura y llévala a la planta.</field></shadow></value></block></value></block></next></block></statement><value name="IF2"><shadow type="logic_boolean" id="p0ay#~B}NME9tf-RdIr8"><field name="BOOL">TRUE</field></shadow><block type="logic_compare" id="T:Q@v1=QprJoIwahq~M!"><field name="OP">EQ</field><value name="A"><shadow type="math_number" id="aRC2=cRm-nr-R!P/VSF?"><field name="NUM">0</field></shadow><block type="variables_get" id="-(nGjmbaySh!9m[`DS9n"><field name="VAR" id="IKW{M#fAJX.[|WI`W3oD">nivelActual</field></block></value><value name="B"><shadow type="math_number" id="Z5d;jI+ln0MAw[POob39"><field name="NUM">3</field></shadow></value></block></value><statement name="DO2"><block type="function_call" id="euQaGioSfF[)HahxfPn6"><mutation name="calcularCosto" functionid="os@{nSPpzel4*Xn(JoR:"></mutation><next><block type="game_show_long_text" id="(|(WQIur19.@.rqiU4uA"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id="|GHm)D.|i4Ej.u]AfF{e"><field name="TEXT"></field></shadow><block type="text_join" id="b/7+MVO]iBj!i(mN={~R"><mutation items="3"></mutation><value name="ADD0"><shadow type="text" id="[8X`xnVJpio)B5,;f_9*"><field name="TEXT">2126: El aire es tóxico. Las máquinas de filtración no funcionan hace años. Busca </field></shadow></value><value name="ADD1"><shadow type="text" id="IR|1|un,Ddya+a-{XS0~"><field name="TEXT"></field></shadow><block type="variables_get" id="03_E)1n]U|ZOpkEwv!lR"><field name="VAR" id="~!d.=1:~98t9;^ftkQWc">costoReparacion</field></block></value><value name="ADD2"><shadow type="text" id="^].WGtI;@;#m=.ly:3a{"><field name="TEXT"> piezas y actívalas. Necesitamos aire limpio.</field></shadow></value></block></value></block></next></block></statement><statement name="ELSE"><block type="function_call" id="z:|e#0nONDr,f9tA}x[G"><mutation name="calcularCosto" functionid="os@{nSPpzel4*Xn(JoR:"></mutation><next><block type="game_show_long_text" id="h:z9CVg98gU[5{NHB1)^"><field name="layout">DialogLayout.Full</field><value name="str"><shadow type="text" id=".z56d6_NUMRaApqQB2^e"><field name="TEXT"></field></shadow><block type="text_join" id="BzMc!.(ZaX#YDbR=#OJO" inline="false"><mutation items="5"></mutation><value name="ADD0"><shadow type="text" id="bTR=(X2w,J4))8}d349l"><field name="TEXT">2126: El parque necesita vida. Camina hasta </field></shadow></value><value name="ADD1"><shadow type="text" id="Eyo4}EuKQH6P.-uSm:lm"><field name="TEXT"></field></shadow><block type="variables_get" id="R3G0q@Rtoy,JXJ7)YQ6s"><field name="VAR" id="OstKn#8z}J#sU64!!`*D">arbolesParaGanar</field></block></value><value name="ADD2"><shadow type="text" id="jwq.sMLwX^25-b!C`j`I"><field name="TEXT"> arboles secos para regarlos. Luego busca </field></shadow></value><value name="ADD3"><shadow type="text" id="Vqw#$xc7mQ(Pq/]/.yZ`"><field name="TEXT"></field></shadow><block type="variables_get" id="%VKY8O:6n$YfK!jf:jiR"><field name="VAR" id="~!d.=1:~98t9;^ftkQWc">costoReparacion</field></block></value><value name="ADD4"><shadow type="text" id="*T2LT43H,0k^c(_w:Wt6"><field name="TEXT"> piezas y repara el riego. Cuida los brotes verdes: si los pisas, pulsa A sobre ellos para revivirlos.</field></shadow></value></block></value></block></next></block></statement><next><block type="function_call" id="BW.M-f?J}Ut}J$1c1g;O"><mutation name="continuarExplorando" functionid="xVy%$H(|^)h@emTZ+FR@"></mutation></block